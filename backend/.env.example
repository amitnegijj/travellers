DATABASE_URL=postgresql://travel:travel_dev_password@localhost:5544/travel
AUTH_SECRET=dev_only_secret_change_me_in_production_0123456789abcdef
PORT=4000
# Origin the browser SPA is served from — must match exactly, cookies depend on it.
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# SSL to Postgres: on automatically for any non-local host (Supabase, Neon…),
# off for localhost. Set to "true" or "false" only to override that.
# DATABASE_SSL=
# Photo storage. Leave unset locally (photos go to backend/public/uploads).
# Required on Vercel: Supabase → Project Settings → API.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=media
